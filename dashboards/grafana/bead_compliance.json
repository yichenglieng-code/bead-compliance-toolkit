{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus instance scraping bead-data metrics.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "BEAD compliance",
  "uid": "bead-compliance-v0",
  "description": "The four NTIA last-mile thresholds, per sample set, from bead-data metrics. Verdicts are indicative: the binding determination is made by the Eligible Entity and NTIA.",
  "tags": ["bead", "broadband", "ntia", "compliance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": { "from": "now-90d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "state",
        "label": "State / territory",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(bead_sample_set_compliant, state)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "technology",
        "label": "Technology",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(bead_sample_set_compliant, technology)",
        "refresh": 1,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overall",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Non-compliant sample sets",
      "description": "Sample sets failing at least one of the four thresholds. Any value above zero needs attention.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(bead_sample_set_compliant{state=~\"$state\",technology=~\"$technology\"} == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Compliant sample sets",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(bead_sample_set_compliant{state=~\"$state\",technology=~\"$technology\"} == 1) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Funded locations reported",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bead_sample_set_locations{state=~\"$state\",technology=~\"$technology\"})",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Invalid records excluded",
      "description": "Records that failed validation and were left out of these figures. Run bead-data validate to see why.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "refId": "A", "expr": "bead_records_invalid", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "Per sample set",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Threshold verdicts",
      "description": "1 is pass, 0 is fail. A missing cell means the threshold had no data reported, which is not a pass.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_threshold_compliant{state=~\"$state\",technology=~\"$technology\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "color-background" } },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "PASS", "color": "green", "index": 1 } } }
          ]
        },
        "overrides": []
      },
      "options": { "showHeader": true }
    },
    {
      "type": "bargauge",
      "title": "Speed pass ratios against the 80% requirement",
      "description": "Share of measurements at or above 80% of the required speed. Download and upload are judged separately and each must independently reach 80%.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_download_pass_ratio{state=~\"$state\",technology=~\"$technology\"}",
          "legendFormat": "download {{sample_set}}",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "bead_upload_pass_ratio{state=~\"$state\",technology=~\"$technology\"}",
          "legendFormat": "upload {{sample_set}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "bargauge",
      "title": "Latency pass ratio against the 95% requirement",
      "description": "Share of round-trip measurements at or below 100 ms. Lost-packet tests count as tests that did not meet the standard.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_latency_pass_ratio{state=~\"$state\",technology=~\"$technology\"}",
          "legendFormat": "{{sample_set}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.8,
          "max": 1,
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "bargauge",
      "title": "Mean outage hours against the 48 hour ceiling",
      "description": "Average bona fide outage hours over the trailing 365 days. Must stay under 48.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_outage_hours_mean{state=~\"$state\",technology=~\"$technology\"}",
          "legendFormat": "{{sample_set}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "min": 0,
          "max": 60,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 38 },
              { "color": "red", "value": 48 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "table",
      "title": "Observed means, for context only",
      "description": "None of the four thresholds is decided on an average. These are here to interpret a failure, not to judge one.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_download_mbps_mean{state=~\"$state\",technology=~\"$technology\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "bead_upload_mbps_mean{state=~\"$state\",technology=~\"$technology\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "bead_latency_ms_mean{state=~\"$state\",technology=~\"$technology\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "row",
      "title": "Buildout and provenance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Locations by build status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "bead_locations{state=~\"$state\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true } } }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "piechart",
      "title": "BABA units by compliance path",
      "description": "Domestic certification is backed by a manufacturer letter; waiver units are reported through the NTIA waiver tracker instead.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compliance_path) (bead_baba_units)",
          "legendFormat": "{{compliance_path}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "piechart",
      "title": "BABA units by country of origin",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origin_country) (bead_baba_units)",
          "legendFormat": "{{origin_country}}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
